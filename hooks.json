{
  "safety-firewall": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre-command-guard.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "skill-router": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/hooks/skill-router.js",
        "timeout": 5
      }
    ]
  },
  "ui-quality-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/hooks/ui-quality-gate.js",
        "timeout": 60
      }
    ]
  }
}
