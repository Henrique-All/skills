{
  "safety-firewall": {
    "PreToolUse": [
      {
        "matcher": "run_command|execute_command|bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre-command-guard.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/post-edit-cartography.js"
          }
        ]
      }
    ]
  }
}
