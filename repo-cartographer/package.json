{
  "name": "repo-cartographer-skill",
  "version": "2.6.0",
  "description": "Cartógrafo de repositórios: mapeamento 360° em 6 camadas, detecção de módulos órfãos (dead code), Context IR incremental e handshake estruturado com hybrid-orchestrator",
  "main": "scripts/cartographer.js",
  "scripts": {
    "test": "node test/validate.js",
    "install:local": "node install.js",
    "install:global": "node install.js --global --target=all",
    "install:both": "node install.js --both",
    "cartographer": "node scripts/cartographer.js",
    "orphans": "node scripts/cartographer.js orphans",
    "preview": "node scripts/preview-graph.js",
    "mermaid": "node scripts/cartographer.js mermaid",
    "callers": "node scripts/cartographer.js callers"
  },
  "keywords": [
    "antigravity",
    "skills",
    "cartographer",
    "architecture-graph",
    "obsidian",
    "context-ir",
    "hybrid-orchestrator",
    "claude-code",
    "cursor"
  ],
  "author": "Henrique Alves",
  "license": "MIT"
}
